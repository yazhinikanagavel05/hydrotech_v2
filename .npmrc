# Every dependency this project installs is a build-time dependency.
#
# `vite` and the rest of the toolchain are devDependencies, but the production
# bundle is not prebuilt — it is compiled on the machine that runs `vite build`.
# So a production install has to include them.
#
# Without this line, any environment that sets NODE_ENV=production (many CI
# runners and hosting builders do) makes npm skip devDependencies: the install
# succeeds, `node_modules/.bin/vite` never appears, and the build dies with
#
#     Command "vite build" exited with 127        <- 127 = command not found
#
# `include` is the documented inverse of `omit`, and it takes precedence, so this
# keeps the toolchain installed regardless of NODE_ENV. `npm ci` on a hosting
# builder goes from 9 packages to the full 118.
include=dev
